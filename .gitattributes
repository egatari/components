# Component files are released byte for byte: a lesson records the sha256 of index.js, so no line-ending conversion on checkout
components/** -text
# data/kana/ holds the sources that tools/kana-embed.mjs copies byte for byte into components/kakijun/ (and checks with --check),
# so data/ must not be converted either (a Windows checkout with CRLF made the copies differ)
data/** -text
